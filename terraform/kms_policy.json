{
  "Sid": "Zero-Copy PII Proxy Nitro Enclave KMS Decrypt Policy",
  "Statement": [
    {
      "Sid": "Allow KMS Decrypt only from attested Nitro Enclave",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_ID:role/nitro-enclave-execution-role"
      },
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:RecipientAttestation:ImageSha384": "PLACEHOLDER_PCR0_SHA384_HASH",
          "kms:RecipientAttestation:PCR3": "PLACEHOLDER_PCR3_SHA384_HASH"
        }
      }
    },
    {
      "Sid": "Deny all other Decrypt attempts",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "kms:RecipientAttestation:ImageSha384": "PLACEHOLDER_PCR0_SHA384_HASH"
        }
      }
    },
    {
      "Sid": "Deny Decrypt if PCR3 mismatches (role ARN)",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "kms:RecipientAttestation:PCR3": "PLACEHOLDER_PCR3_SHA384_HASH"
        }
      }
    },
    {
      "Sid": "Allow key administration by operations team",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_ID:role/kms-admin-role"
      },
      "Action": [
        "kms:CreateGrant",
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:ListGrants",
        "kms:RevokeGrant"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Allow AWS services to use the key",
      "Effect": "Allow",
      "Principal": {
        "Service": "kms.amazonaws.com"
      },
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:CreateGrant"
      ],
      "Resource": "*"
    }
  ]
}
