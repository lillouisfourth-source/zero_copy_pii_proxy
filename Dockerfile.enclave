FROM rust:1.98.0-alpine3.24@sha256:a10e64dd139b7387337c7fbe8aca31b959b57b2fd4c8ae20a02cf1d6ea424dce AS builder

RUN apk add --no-cache musl-dev make
ENV SOURCE_DATE_EPOCH=1704067200
ENV RUSTFLAGS="--remap-path-prefix=/build=/workspace"

WORKDIR /build
ARG CARGO_FEATURES=""
COPY Cargo.toml Cargo.lock ./
COPY src ./src

RUN RUSTFLAGS="${RUSTFLAGS} -C debuginfo=0 -C strip=symbols" cargo build --release \
    --target x86_64-unknown-linux-musl \
    --locked \
    --features nitro \
    --bin zero_copy_pii_proxy

RUN strip /build/target/x86_64-unknown-linux-musl/release/zero_copy_pii_proxy

FROM scratch
ENV SOURCE_DATE_EPOCH=1704067200

COPY --from=builder /build/target/x86_64-unknown-linux-musl/release/zero_copy_pii_proxy /zero_copy_pii_proxy

ENTRYPOINT ["/zero_copy_pii_proxy"]