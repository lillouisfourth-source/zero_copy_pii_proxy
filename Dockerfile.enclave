FROM rust:1.98.0-alpine3.24@sha256:a10e64dd139b7387337c7fbe8aca31b959b57b2fd4c8ae20a02cf1d6ea424dce AS builder

ARG SOURCE_DATE_EPOCH=1704067200
RUN apk add --no-cache musl-dev make ca-certificates
RUN touch -d @${SOURCE_DATE_EPOCH} /etc/ssl/certs/ca-certificates.crt
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
ENV RUSTFLAGS="--remap-path-prefix=/build=/workspace"

WORKDIR /build
ARG CARGO_FEATURES=""
COPY Cargo.toml Cargo.lock ./
COPY src ./src

RUN RUSTFLAGS="${RUSTFLAGS} -C debuginfo=0 -C strip=symbols" cargo build --release \
    --target x86_64-unknown-linux-musl \
    --locked \
    ${CARGO_FEATURES} \
    --bin zero_copy_pii_proxy

RUN strip /build/target/x86_64-unknown-linux-musl/release/zero_copy_pii_proxy
RUN touch -d @${SOURCE_DATE_EPOCH} /build/target/x86_64-unknown-linux-musl/release/zero_copy_pii_proxy
RUN mkdir -p /rootfs/etc/ssl/certs /rootfs/app
RUN cp /build/target/x86_64-unknown-linux-musl/release/zero_copy_pii_proxy /rootfs/app/zero-copy-pii-proxy
RUN cp /etc/ssl/certs/ca-certificates.crt /rootfs/etc/ssl/certs/ca-certificates.crt
RUN find /rootfs -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM scratch
ENV SOURCE_DATE_EPOCH=1704067200

COPY --from=builder /rootfs /

ENTRYPOINT ["/app/zero-copy-pii-proxy"]