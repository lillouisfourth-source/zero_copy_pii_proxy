FROM rust:1.98.0-alpine3.24 AS builder

RUN apk add --no-cache musl-dev make
ENV SOURCE_DATE_EPOCH=1
ENV RUSTFLAGS="--remap-path-prefix=/build=/workspace"

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src

RUN RUSTFLAGS="${RUSTFLAGS} -C debuginfo=0 -C strip=symbols" cargo build --release \
    --target x86_64-unknown-linux-musl \
    --locked \
    --features nitro \
    --bin zero_copy_pii_proxy

FROM scratch

COPY --from=builder /build/target/x86_64-unknown-linux-musl/release/zero_copy_pii_proxy /proxy

ENTRYPOINT ["/proxy"]