{
  "title": "Zero-Copy PII Proxy",
  "uid": "zero-copy-pii-proxy",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request throughput",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "rate(proxy_requests_total[1m])", "legendFormat": "requests/sec"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Active SSE streams",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "active_sse_streams", "legendFormat": "streams"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Proxy byte budget in use",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "proxy_byte_budget_in_use", "legendFormat": "bytes"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "max": 2097152}, "overrides": []}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "PII redaction rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "rate(pii_redactions_total[1m])", "legendFormat": "redactions/sec"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    }
  ]
}
